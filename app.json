{
  "expo": {
    "name": "AG Scan Offline",
    "slug": "ag-scan-offline",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "android"
    ],
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "enabled": false
    },
    "android": {
      "package": "com.okem.agscan",
      "versionCode": 1,
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AG Scan to use the camera for on-device person and safety-colour detection."
        }
      ],
      "expo-audio",
      "expo-asset"
    ]
  }
}
